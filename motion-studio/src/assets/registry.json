  "sfx": [
    {
      "id": "SFX_PAPER_SNAP",
      "character": "Crisp vintage cardstock snap",
      "defaultVolume": 0.35,
      "variants": 4,
      "rule": "Trigger on frame 0 of Zone L/R card entrances."
    },
    {
      "id": "SFX_BRUTAL_THUD",
      "character": "Low-end mechanical architectural stamp",
      "defaultVolume": 0.40,
      "variants": 4,
      "rule": "Trigger when BrutalistLowerThird or heavy architecture locks in."
    },
    {
      "id": "SFX_WIRE_SWISH",
      "character": "Metallic springy ruled-surface whoosh",
      "defaultVolume": 0.30,
      "variants": 4,
      "rule": "Trigger when GegoMeshPointer, HyparNet, or Viaduct lines draw on."
    },
    {
      "id": "SFX_TYPE_CLACK",
      "character": "Mechanical letterpress clack",
      "defaultVolume": 0.25,
      "variants": 4,
      "rule": "Trigger per word or bullet reveal on kinetic emphasis."
    },
    {
      "id": "SFX_KINETIC_HUM",
      "character": "Warm analog synth optical shimmer",
      "defaultVolume": 0.20,
      "variants": 4,
      "rule": "Trigger during continuous Cruz-Diez / Soto moiré shifts."
    }
  ]
